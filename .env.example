# Bot token — discord.com/developers/applications → your app → Bot → Reset Token
# (toggle ON "Presence Intent" + "Server Members Intent" under Privileged Gateway Intents)
DISCORD_TOKEN=

# The guild (server) the bot watches — right-click the server name → Copy Server ID
# (needs Discord Settings → Advanced → Developer Mode). Only members of this
# server get a presence snapshot.
GUILD_ID=

# Optional — HTTP port for the API, default 4555
PORT=4555

# Optional but required for real badges. Discord returns 20001 "Bots cannot
# use this endpoint" on /users/{id}/badges AND /users/{id}/profile, so a bot
# token cannot read the badge directory. Paste a USER account token here to
# get Nitro tiers, Account Age, Quests, etc. Without it faulrpc falls back
# to public-flag badges only. Keep this secret; .env is git-ignored.
DISCORD_USER_TOKEN=

# Shared secret for the Vencord badge bridge (vencord-plugin/faulrpc-badges).
# Set this to any long random string, and paste the same value into the
# plugin's "BADGE_PUSH_KEY" setting. POST /badges is rejected without it.
BADGE_PUSH_KEY=

# Optional — where pushed badge catalogs are persisted, and how long a push
# stays valid before faulrpc tries other sources again.
# Defaults: data/badges.json and 30 days.
BADGE_STORE_FILE=
BADGE_PUSH_MAX_AGE_MS=
