# Bot token — discord.com/developers/applications → your app → Bot → Reset Token
# (toggle ON "Presence Intent" + "Server Members Intent" under Privileged Gateway Intents)
DISCORD_TOKEN=

# The guild (server) the bot watches — right-click the server name → Copy Server ID
# (needs Discord Settings → Advanced → Developer Mode). Only members of this
# server get a presence snapshot.
GUILD_ID=

# Optional — HTTP port for the API, default 4555
PORT=4555
